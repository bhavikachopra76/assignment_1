# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET=documents

# Database Connection String (PostgreSQL URL)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Google Cloud Platform (Vertex AI) Configuration
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=your-gcp-key.json

# Cohere API Configuration
COHERE_KEY=your-cohere-api-key

# Allowed browser origins, comma separated, no trailing slashes.
# Only needs changing once the frontend is deployed somewhere other than localhost.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
